# Copy to .env on the SERVER machine only. Never commit .env.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: the team default chain is below (same as ai.py). Delete these two lines to use the defaults,
# or change them to try other models. Tried in order; HTTP 429 / 404 / 503 moves to the next one.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash,gemini-3-flash-preview,gemini-2.5-flash-lite,gemini-2.5-flash
